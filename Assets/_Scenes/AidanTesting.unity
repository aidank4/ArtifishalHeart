  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueController
  dialogueLines:
  - text: "Hey, I saw you earlier at the beach and I couldn\u2019t help but keep
      my camera on you."
    question: 0
    player: 1
    fish: 0
    finishesDate: 0
  - text: What is your name?
    question: 0
    player: 1
    fish: 0
    finishesDate: 0
  - text: "Oooh, that\u2019s nice, my name is Datem! "
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: What is yours?
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: "I\u2019m F1scher!  "
    question: 0
    player: 1
    fish: 0
    finishesDate: 0
  - text: Is there anything I can do for you?
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: Oh ya, I almost forgot, I brought you this fish!
    question: 0
    player: 1
    fish: 1
    finishesDate: 0
  - text: Fish Response
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: What do you like doing when you are not busy?
    question: 1
    player: 0
    fish: 0
    finishesDate: 0
  - text: Question Response
    question: 0
    player: 1
    fish: 0
    finishesDate: 0
  - text: Datem Response
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: What do you like to do?
    question: 0
    player: 1
    fish: 0
    finishesDate: 0
  - text: "Hmmm\u2026 recently I have been loving sushi."
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: I really like that local fish, the gold fih!
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: "That\u2019s awesome I think I have seen those before!"
    question: 0
    player: 1
    fish: 0
    finishesDate: 0
  - text: I will keep my camera out for one!
    question: 0
    player: 1
    fish: 0
    finishesDate: 0
  - text: hahaha okk, it was nice meeting you.
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: 'The pleasure is all mine. '
    question: 0
    player: 1
    fish: 0
    finishesDate: 1
  - text: Datem!!! I am so happy to see you!
    question: 0
    player: 1
    fish: 0
    finishesDate: 0
  - text: Look what I found! I brought it for you.
    question: 0
    player: 1
    fish: 1
    finishesDate: 0
  - text: 'Fish Response '
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: I also thought about you today.
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: What do you think of my outfit?
    question: 1
    player: 0
    fish: 0
    finishesDate: 0
  - text: Choice Response
    question: 0
    player: 1
    fish: 0
    finishesDate: 0
  - text: Response Response
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: What do you think of mine?
    question: 0
    player: 1
    fish: 0
    finishesDate: 0
  - text: I think you are really cute!
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: "\u2026 beep"
    question: 0
    player: 1
    fish: 0
    finishesDate: 0
  - text: What did you say?
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: "Nothing, nothing\u2026"
    question: 0
    player: 1
    fish: 0
    finishesDate: 0
  - text: Oh ok, I was almost worried.
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: Are you having a good time?
    question: 1
    player: 0
    fish: 0
    finishesDate: 0
  - text: Choice Response
    question: 0
    player: 1
    fish: 0
    finishesDate: 0
  - text: Response Response
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: Thanks
    question: 0
    player: 1
    fish: 0
    finishesDate: 0
  - text: Oh no! I am so sorry!
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: My electricity started feeling weird.
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: Oh no, should I go?
    question: 0
    player: 1
    fish: 0
    finishesDate: 0
  - text: "Ya, I am sorry, it\u2019s urgent!"
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: Wait, but hold on. Come see me tomorrow!
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: Alright!
    question: 0
    player: 1
    fish: 0
    finishesDate: 1
  - text: F1scher how was your day!
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: So Amazing!!!! I caught so many fish!!
    question: 0
    player: 1
    fish: 0
    finishesDate: 0
  - text: Oh wow, did you bring me one?
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: Yes, here you go.
    question: 0
    player: 1
    fish: 0
    finishesDate: 0
  - text: I hope you like it!
    question: 0
    player: 1
    fish: 1
    finishesDate: 0
  - text: Fish Response
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: Would you like to come fishing with me this weekend?
    question: 0
    player: 1
    fish: 0
    finishesDate: 0
  - text: I would love to!
    question: 0
    player: 0
    fish: 0
    finishesDate: 0
  - text: YAY! I just struck goldfish!
    question: 0
    player: 1
    fish: 0
    finishesDate: 0
  - text: Hahahaha you are so funny!
    question: 0
    player: 0
    fish: 0
